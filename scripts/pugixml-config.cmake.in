@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/pugixml-mbf-targets.cmake")

# If the user is not requiring 1.11 (either by explicitly requesting an older
# version or not requesting one at all), provide the old imported target name
# for compatibility.
if (NOT TARGET pugixml-mbf AND (NOT DEFINED PACKAGE_FIND_VERSION OR PACKAGE_FIND_VERSION VERSION_LESS "1.11"))
  add_library(pugixml-mbf INTERFACE IMPORTED)
  # Equivalent to target_link_libraries INTERFACE, but compatible with CMake 3.10
  set_target_properties(pugixml-mbf PROPERTIES INTERFACE_LINK_LIBRARIES pugixml-mbf::pugixml-mbf)
endif ()
